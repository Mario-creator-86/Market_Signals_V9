# Environment Variables — Market Signals V9 - Premium
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ===================== REQUIRED FOR EXTERNAL DATA =====================

# Finnhub API key (optional, enhances news coverage)
# Get one free at https://finnhub.io/register
FINNHUB_API_KEY=

# Required before SEC EDGAR access is enabled. The SEC expects an identifiable
# name and contact email; keep the real value in .env, never in config or Git.
EDGAR_IDENTITY=

# MLflow experiment tracking — the server auto-starts with the application when
# MLFLOW_TRACKING_URI is set. Requires: pip install mlflow (already in requirements.txt).
# The System Health MLflow tile turns HEALTHY once the server answers /health.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# RD-Agent worker — Microsoft RD-Agent autonomous research framework.
# Set RD_AGENT_ENABLED=1 to activate the subprocess manager.
# Requires Python 3.10 installed (or point RD_AGENT_PYTHON_310 at a 3.10/3.11 binary).
# V9 creates a venv at RD_AGENT_VENV_PATH (default: runtime/rdagent_venv),
# installs rdagent, and starts the worker on RD_AGENT_ENDPOINT.
RD_AGENT_ENABLED=
RD_AGENT_ENDPOINT=http://127.0.0.1:19000
RD_AGENT_WORKSPACE=runtime/rdagent_workspace
RD_AGENT_VENV_PATH=runtime/rdagent_venv
# Optional: explicit path to a Python 3.10/3.11 interpreter for the RD-Agent venv.
# Leave blank to let V9 auto-detect from PATH (py, python3.10, python310 …).
RD_AGENT_PYTHON_310=

# Alpaca market data (IEX stocks + US crypto snapshots)
# Compatible aliases: APCA_API_KEY_ID / APCA_API_SECRET_KEY
ALPACA_API_KEY=
ALPACA_SECRET_KEY=


# ===================== OLLAMA (AI ANALYSIS) =====================

# Path to the Ollama executable (required if Ollama is not in PATH)
# Example: C:\Users\YourName\AppData\Local\Programs\Ollama\ollama.exe
OLLAMA_EXE=

# Ollama base URL (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Collapse repeated availability/model-catalog probes from concurrent agents.
OLLAMA_AVAILABILITY_TTL_SECONDS=30
OLLAMA_UNAVAILABLE_TTL_SECONDS=5
OLLAMA_MODELS_TTL_SECONDS=60
OLLAMA_MODELS_EMPTY_TTL_SECONDS=10

# ===================== SERVER CONFIGURATION =====================

# Server host and port. Keep loopback for local use.
MS_HOST=127.0.0.1
MS_PORT=8003

# Production Compose boundary. These two values are intentionally empty so
# `docker compose` fails before deployment until the real HTTPS identity is set.
MS_PUBLIC_HOST=
MS_PUBLIC_ORIGIN=
MS_PUBLIC_PORT=8003
MS_IMAGE_TAG=local

# Production boundary. Generate a random API key with at least 32 characters.
MS_ENV=development
MS_API_KEY=
# Independent HMAC key for the append-only operator audit chain. In production
# this is mandatory, at least 32 characters, and must differ from MS_API_KEY.
MS_AUDIT_HMAC_KEY=
# During a controlled audit-key rotation, keep older keys here (comma-separated)
# until all retained ledgers using them have expired from policy.
MS_AUDIT_HMAC_PREVIOUS_KEYS=
# Read-only credential accepted only by GET /api/metrics.
MS_METRICS_BEARER_TOKEN=
MS_API_KEY_MIN_LENGTH=32
MS_REQUIRE_API_KEY=0
MS_PROTECT_READS=0
MS_AUTH_SESSION_TTL_SECONDS=28800
MS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MS_ALLOWED_ORIGINS=
MS_FORCE_HTTPS=0
MS_TLS_TERMINATED=0
MS_ALLOW_INSECURE_ORIGINS=0

# ===================== API TRAFFIC PROTECTION =====================

# Mandatory in production. Limits are per API process; keep an edge proxy/load
# balancer limit as the shared boundary when running multiple replicas.
MS_TRAFFIC_CONTROL_ENABLED=1
MS_RATE_LIMIT_WINDOW_SECONDS=60
MS_RATE_LIMIT_READS=240
MS_RATE_LIMIT_WRITES=20
MS_RATE_LIMIT_AUTH_ATTEMPTS=5
MS_RATE_LIMIT_MAX_BUCKETS=10000
MS_MAX_REQUEST_BODY_BYTES=1048576
MS_API_MAX_INFLIGHT=128
MS_API_MAX_INFLIGHT_PER_CLIENT=16

# Optional path overrides. The production container assigns these to its
# dedicated persistent volumes; local development defaults to runtime/ + data/.
MS_RUNTIME_DIR=
MS_DATA_DIR=
MS_CONFIG_PATH=
MS_RISK_CONSTITUTION_PROFILES_PATH=
MS_WATCHLIST_PATH=
MS_STATE_PATH=
MS_SIGNALS_PATH=
MS_CAPITAL_STATE_PATH=
MS_SQLITE_DB_PATH=
MS_LOG_DIR=
MS_AUDIT_LOG_DIR=
MS_OPERATOR_AUDIT_PATH=

# ===================== BACKUP / DISASTER RECOVERY =====================

# Verified online SQLite + runtime JSON snapshot schedule.
MS_BACKUP_ENABLED=1
MS_BACKUP_DIR=
MS_BACKUP_INTERVAL_SECONDS=86400
MS_BACKUP_STARTUP_DELAY_SECONDS=120
MS_BACKUP_RETENTION_COUNT=7
MS_BACKUP_RETENTION_DAYS=30

# The large root-level news_backup directory is excluded by default.
MS_BACKUP_INCLUDE_NEWS_ARCHIVE=0

# Keep disabled. Set to 1 only while the API and engine are stopped and an
# acknowledged production-root restore is intentionally being performed.
MS_RESTORE_ALLOWED=0

# ===================== TEST / DEVELOPMENT TOGGLES =====================

# Set to 1 to enable test mode (disables engine autostart, warmup, external calls)
TEST_MODE=0

# Set to 1 to disable background engine autostart
MS_DISABLE_ENGINE_AUTOSTART=0

# Set to 1 to disable startup warmup prefetch
MS_DISABLE_WARMUP=0

# Set to 1 to disable state prefetch on startup
MS_DISABLE_STATE_PREFETCH=0

# Set to 1 to disable background worker
MS_DISABLE_BG_WORKER=0

# Slow request warning threshold in milliseconds (default: 500)
MS_SLOW_REQUEST_MS=500

# Rolling API service-level objectives exported through /api/metrics.
MS_SLO_WINDOW_SECONDS=300
MS_SLO_AVAILABILITY_TARGET_PCT=99.9
MS_SLO_P95_TARGET_MS=500
MS_SLO_MINIMUM_REQUESTS=20

# Minimum delay before retrying News agent initialization (default: 15 seconds)
MS_NEWS_AGENT_INIT_RETRY_SECONDS=15

# Provider governor cooldowns. Authentication/billing/rate-limit failures are
# suppressed per host + endpoint so one bad upstream cannot create retry storms.
MS_HTTP_AUTH_COOLDOWN_SECONDS=300
MS_HTTP_BILLING_COOLDOWN_SECONDS=1800
MS_HTTP_RATE_LIMIT_COOLDOWN_SECONDS=60

# Per-agent external-call budgets. A value is the maximum actual HTTP attempts
# allowed in one agent cycle; cache hits do not consume the budget.
MS_AGENT_EXTERNAL_BUDGET_DEFAULT=20
MS_AGENT_EXTERNAL_BUDGET_SCANNER=20
MS_AGENT_EXTERNAL_BUDGET_TRADE_RADAR=15
MS_AGENT_EXTERNAL_BUDGET_STRATEGY_RESEARCH=15
MS_TRADE_RADAR_AUTO_MAX_PER_CYCLE=4
MS_TRADE_RADAR_AUTO_CACHE_ONLY=1
MS_NEWS_EXTERNAL_CALL_BUDGET=20
PREMARKET_EXTERNAL_CALL_BUDGET=24
PRE_EARNINGS_EXTERNAL_CALL_BUDGET=30
PRE_EARNINGS_COVERAGE_WARMUP_MAX_SYMBOLS=5
PRE_EARNINGS_PULSE_ACTIVE_MAX_PER_SIDE=500
PRE_EARNINGS_PULSE_HISTORY_RESPONSE_LIMIT=20
PRE_EARNINGS_PULSE_UNDATED_RETENTION_DAYS=45
# Optional override; defaults to %MS_DATA_DIR%/pre_earnings_pulse_history.json.
# PRE_EARNINGS_PULSE_HISTORY_PATH=C:\path\to\data\pre_earnings_pulse_history.json

# Stagger heavy agents during startup while persisted state remains available.
PREMARKET_STARTUP_DELAY_SECONDS=8
PRE_EARNINGS_STARTUP_DELAY_SECONDS=20
MS_NEWS_STARTUP_DELAY_SECONDS=30
TRADE_RADAR_STARTUP_DELAY_SECONDS=45
# Cloud AI provider keys (optional — set in the UI: Watchlist > Global Settings > AI Model)
# KIMI_API_KEY=
# ZAI_API_KEY=
